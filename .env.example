# Copy to .env and fill in. Never commit .env.

# LLM (CrewAI model string, ADR-0001)
LLM_MODEL=ollama/llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=120
# Hosted provider alternative (only when LLM_MODEL points to it):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Storage and ingestion
DATA_DIR=storage
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=10

# Retrieval and answering
RETRIEVAL_K=5
MIN_RELEVANCE_SCORE=0.35
MAX_QUESTION_CHARS=1000

# Langfuse (Langfuse Cloud project keys)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# CrewAI telemetry and tracing (keep disabled)
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
